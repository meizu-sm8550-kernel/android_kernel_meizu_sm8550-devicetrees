					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x79>;

					smb1510_present@5d {
						reg = <0x5d 0x01>;
						bits = <0x05 0x05>;
						phandle = <0x7a>;
					};

